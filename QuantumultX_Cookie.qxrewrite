hostname = hrmapp.hitrontech.com, sytgate.jslife.com.cn, mcs-mimp-web.sf-express.com, ccsp-egmas.sf-express.com, wapside.189.cn, m.client.10010.com, mxx.client.10010.com, ms.jr.jd.com, me-api.jd.com, api.m.jd.com,passport.iqiyi.com,*.video.qq.com,music.163.com,*.bilibili.com,113.96.156.178,*.ximalaya.com,zhiyou.smzdm.com,fmapp.chinafamilymart.com.cn,wx-mini.pagoda.com.c,maicai.api.ddxq.mobi,user-api-prd-mx.wandafilm.com,cms-activity-api-prd-mx.wandafilm.com,*.qunar.com

