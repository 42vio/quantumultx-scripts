^https:\/\/mcs-mimp-web\.sf-express\.com\/mcs-mimp\/commonPost\/~memberNonactivity~integralSignV2Service~getTodaySign url script-response-body https://raw.githubusercontent.com/42vio/quantumultx-scripts/main/scripts/sfexpress.cookie.js

